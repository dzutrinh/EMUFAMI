@ECHO OFF
REM EMUFAMI's build, either compiler on its own:
REM   BUILD            EMUFAMI.EXE by TMT Pascal (C:\TMT), DOS/4GW: DOS4GW.EXE
REM                    beside it or on the PATH
REM   BUILD FPC        EMUFAMI.EXE by Free Pascal (C:\PP), go32v2: CWSDPMI.EXE
REM                    beside it or on the PATH
SET TPC=C:\TMT\BIN\TMTPC.EXE
SET FPCC=C:\PP\BIN\GO32V2\FPC.EXE
SET FLAGS=-B -UNIT:.;C:\TMT\UNITS -$LOGO- -STACK:262144
IF "%1"=="FPC" GOTO FPC
IF "%1"=="fpc" GOTO FPC
%TPC% %FLAGS% -STUB:WSTUB.EXE EMUFAMI.PAS
GOTO TIDY
:FPC
%FPCC% -O2 EMUFAMI.PAS
:TIDY
IF EXIST *.SYM DEL *.SYM
IF EXIST *.FPD DEL *.FPD
IF EXIST *.O DEL *.O
IF EXIST *.PPU DEL *.PPU
SET TPC=
SET FPCC=
SET FLAGS=
