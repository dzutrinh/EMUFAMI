# EMUFAMI's makefile, for Borland MAKE (C:\BP\BIN\MAKE.EXE):
#   MAKE              all three
#   MAKE bp           FAMI_B.EXE by Borland Pascal 7, 16-bit protected
#                     mode: RTM.EXE and DPMI16BI.OVL beside it or on the PATH
#   MAKE tmt          FAMI_T.EXE by TMT Pascal, DOS/4GW: DOS4GW.EXE
#   MAKE fpc          FAMI_F.EXE by Free Pascal, go32v2: CWSDPMI.EXE
#   MAKE clean        the programs, OBJ\ removed
# Each compiler works in its own folder under OBJ\, emptied and removed
# once its program is in .\ (every build compiles all units again).
# The compilers' paths can be given: MAKE -DBPC=D:\BP\BIN\BPC.EXE bp

!if !$d(BPC)
BPC = C:\BP\BIN\BPC.EXE
!endif
!if !$d(TMTPC)
TMTPC = C:\TMT\BIN\TMTPC.EXE
!endif
!if !$d(FPC)
FPC = C:\PP\BIN\GO32V2\FPC.EXE
!endif

SRC = EMUFAMI.PAS F_APU.PAS F_BUS.PAS F_CART.PAS F_CPU.PAS F_DOS.PAS \
	F_KEYS.PAS F_MAP.PAS F_NES.PAS F_PAD.PAS F_PAL.PAS F_PPU.PAS \
	F_SB.PAS F_SYS.PAS F_TEXT.PAS F_VGA.PAS

all: bp tmt fpc

bp: FAMI_B.EXE
tmt: FAMI_T.EXE
fpc: FAMI_F.EXE

FAMI_B.EXE: $(SRC)
	if not exist OBJ\NUL md OBJ
	if not exist OBJ\B\NUL md OBJ\B
	$(BPC) -CP -B -Q -$G+ -EOBJ\B EMUFAMI.PAS
	copy OBJ\B\EMUFAMI.EXE FAMI_B.EXE
	del OBJ\B\*.TPP
	del OBJ\B\EMUFAMI.EXE
	rd OBJ\B
	-rd OBJ

FAMI_T.EXE: $(SRC)
	if not exist OBJ\NUL md OBJ
	if not exist OBJ\T\NUL md OBJ\T
	$(TMTPC) -B -$LOGO- -STACK:262144 -STUB:WSTUB.EXE -UNIT:.;C:\TMT\UNITS -OUT:OBJ\T\ EMUFAMI.PAS
	copy OBJ\T\EMUFAMI.EXE FAMI_T.EXE
	del OBJ\T\*.FPD
	del OBJ\T\*.SYM
	del OBJ\T\EMUFAMI.EXE
	rd OBJ\T
	-rd OBJ

FAMI_F.EXE: $(SRC)
	if not exist OBJ\NUL md OBJ
	if not exist OBJ\F\NUL md OBJ\F
	$(FPC) -B -O2 -FUOBJ\F -FE. -oFAMI_F.EXE EMUFAMI.PAS
	del OBJ\F\*.O
	del OBJ\F\*.PPU
	rd OBJ\F
	-rd OBJ

# what a build stopped halfway may have left too
clean:
	if exist FAMI_B.EXE del FAMI_B.EXE
	if exist FAMI_T.EXE del FAMI_T.EXE
	if exist FAMI_F.EXE del FAMI_F.EXE
	if exist OBJ\B\*.TPP del OBJ\B\*.TPP
	if exist OBJ\B\EMUFAMI.EXE del OBJ\B\EMUFAMI.EXE
	if exist OBJ\T\*.FPD del OBJ\T\*.FPD
	if exist OBJ\T\*.SYM del OBJ\T\*.SYM
	if exist OBJ\T\EMUFAMI.EXE del OBJ\T\EMUFAMI.EXE
	if exist OBJ\F\*.O del OBJ\F\*.O
	if exist OBJ\F\*.PPU del OBJ\F\*.PPU
	-if exist OBJ\B\NUL rd OBJ\B
	-if exist OBJ\T\NUL rd OBJ\T
	-if exist OBJ\F\NUL rd OBJ\F
	-if exist OBJ\NUL rd OBJ
	-if exist NUL rd BIN
